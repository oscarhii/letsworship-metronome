{
  "name": "sync-metronome-pwa",
  "version": "1.0.0",
  "description": "Offline peer-to-peer metronome PWA for iOS and Android over Wi-Fi",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "test": "node scripts/test_sync.js",
    "worker:dev": "wrangler dev --config cloudflare/wrangler.toml --port 8787",
    "worker:deploy": "wrangler deploy --config cloudflare/wrangler.toml",
    "test:cloud": "node scripts/test_cloud_sync.js"
  },
  "dependencies": {
    "express": "^4.19.2",
    "jsqr": "^1.4.0",
    "pako": "^2.1.0"
  },
  "devDependencies": {
    "wrangler": "^4.125.0"
  }
}
